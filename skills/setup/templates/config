# Shipinetics project settings. "key = value", one per line. "#" starts a comment.
# Every setting is optional: anything left out uses the default shown.
# Paths are relative to this folder's parent (the Shipinetics root), except evidence_dir,
# which is relative to the git repo a PR comes from.
# Print the effective settings with: shipinetics-config

# ---- Where the project keeps things (map these to an existing harness instead of moving files)
# worksheets_dir = docs/worksheets
# feedback_file = docs/agent-feedback.md
# systems_dir = docs/systems
# conventions_file = docs/conventions.md
# testing_guide_file = docs/testing/how-to-write-tests.md
# test_index_file = docs/testing/test-index.md
# tools_index_file = docs/tools.md
# queue_file = TODOS.md
# reviews_dir = docs/reviews
# personas_dir = docs/review/personas
# evidence_dir = docs/evidence

# ---- Verify (single repo)
# Checks run in tiers, each at the moment its result is needed. Nothing is skipped:
#   verify_quick_cmd  mid-task stops, scoped to the changed files ($SHIPINETICS_CHANGED_FILES)
#   verify_cmd        the complete fast checks: the "done" stop (worksheet Status: done), any stop
#                     that changes a path in .shipinetics/complete-paths, pre-push and the PR gate
#   bin/verify --full CI and end of shift
# Leave verify_quick_cmd unset and every stop runs verify_cmd. Timings: shipinetics-verify times
# verify_cmd = bin/verify
# verify_quick_cmd = bin/verify --quick

# ---- Workspace mode: the root holds several package repos and isn't a repo itself.
# Setting packages turns it on. {package} is replaced with the package folder.
# verify_scope = touched verifies only packages the agent edited this session; changed verifies
# every package with uncommitted changes.
# packages = api web
# package_verify_cmd = scripts/validate.sh {package}
# package_verify_quick_cmd = scripts/validate.sh {package} --quick
# verify_scope = touched
# The root's own files (.shipinetics/, the queue, worksheets, docs) need a git repo too, or they
# aren't versioned and night-shift can't run. Either make the root a repo that ignores the package
# folders, or keep them in another repo whose top level mirrors them and link the root to it:
# harness_repo = ../my-workspace-harness

# ---- Hooks
# Switch hooks off for this project: stop, edits, secrets, pr, installs. Without this key, the
# user's own ~/.config/shipinetics/config applies. SHIPINETICS_HOOKS_OFF does the same for a session.
# hooks_off = installs

# ---- Running the app
# agent: agents launch, seed and stop their own instances (the default).
# user: the user runs the servers. Agents only run the doctor, never seed or reset, write only as
# the test account and clean up after themselves. See the verification-map skill.
# launch = agent

# ---- Benchmarks (shipinetics:perf). bin/bench usually wraps: bench-compare -- <the bench command>
# bench_cmd = bin/bench
# package_bench_cmd = bin/bench-package {package}  # workspace mode, {package} is the package folder

# ---- Worksheets: hand off to the project's own scripts if it has them
# worksheet_new_cmd = scripts/new_trace.sh          # receives <slug>, prints the new path
# worksheet_tag_cmd = scripts/tag_trace.sh          # receives [<package>] <worksheet path>
# package_worksheets_dir = .agent-traces            # where packages keep committed worksheet copies
# tag_prefix = ws/

# ---- Secrets: how to run a command with secrets from the vault
# secrets_runner = bin/with-secrets                 # or: infisical run --env=dev --
# The env guards ignore reads of variables that never hold secrets: HOME, PATH, TMPDIR, TMP, TEMP,
# USER, LOGNAME, SHELL, PWD, OLDPWD, LANG, LC_ALL, TERM, TZ, HOSTNAME, EDITOR, NODE_ENV and CI.
# Add the project's own, space-separated. Never list a variable that can hold a secret.
# env_safe_names = APP_ENV LOG_LEVEL
