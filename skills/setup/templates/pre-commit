#!/usr/bin/env bash
# Pre-commit: refuse oversized commits, then fix lint problems in staged files and let the
# commit through if they're clean.
# Install as .githooks/pre-commit and enable with: git config core.hooksPath .githooks
#
# Size limit: a commit may change at most max_lines lines (added plus deleted). Binary files
# and paths matching ignore don't count. Reviewers read a few hundred lines closely and skim
# anything bigger, so big work goes in as several commits that each leave the code working.
# Merges, cherry-picks and reverts pass. For one commit that can't be split (a codemod, a
# vendored library, a generated migration), set SHIPINETICS_ALLOW_BIG_COMMIT=1 and say why in
# the message.

set -uo pipefail

# ---- fill these in for the project ----
max_lines=400   # 0 turns the limit off
ignore='(^|/)(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb?|Cargo\.lock|poetry\.lock|uv\.lock|Pipfile\.lock|go\.sum|Gemfile\.lock|composer\.lock)$|^docs/(evidence|worksheets)/'
# ---------------------------------------

busy() { git rev-parse -q --verify "$1" >/dev/null; }
if [ "$max_lines" -gt 0 ] && [ "${SHIPINETICS_ALLOW_BIG_COMMIT:-0}" != "1" ] &&
   ! busy MERGE_HEAD && ! busy CHERRY_PICK_HEAD && ! busy REVERT_HEAD; then
  counted="$(git diff --cached --numstat -M | IGNORE="$ignore" awk -F'\t' \
    '$1 != "-" && $3 !~ ENVIRON["IGNORE"] { print $1 + $2 "\t" $3 }' | sort -rn)"
  total="$(printf '%s\n' "$counted" | awk -F'\t' '{ t += $1 } END { print t + 0 }')"
  if [ "$total" -gt "$max_lines" ]; then
    {
      echo "pre-commit: this commit changes $total lines. The limit is $max_lines."
      echo "Split it into smaller commits that each leave the code working: unstage files with"
      echo "git restore --staged <file> and commit them separately. Largest files:"
      printf '%s\n' "$counted" | head -n 10 | sed 's/^/  /'
      echo "If it really can't be split, commit with SHIPINETICS_ALLOW_BIG_COMMIT=1 and say why in the message."
    } >&2
    exit 1
  fi
fi

exec bin/lint-fix --staged
