# Secret files. The secrets guard stops agents reading these, or naming them in a command.
# One glob per line. A line without / matches that file or folder name anywhere; a line with /
# matches the end of a path. ~ is your home folder, and * also matches /.
# This list replaces the built-in one, so keep the lines below unless you mean to drop them.
# For every project, put a list in ~/.config/shipinetics/secret-paths instead. A project's list wins.

# Cloud and tool credentials (the built-in list)
.config/gcloud
.config/gcloud/*
application_default_credentials.json
.aws/credentials
.aws/config
.azure
.azure/*
.ssh/id_*
.netrc
.npmrc
.pypirc
.docker/config.json
.kube/config
.git-credentials
.infisical
.infisical/*
.railway
.railway/*

# This project's own secret files, for example:
# .env
# .env.*
# *.pem
# config/service-account.json
