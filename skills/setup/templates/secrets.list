# Secrets this project needs, by name only. Never put a value in this file.
# One per line: ENV_NAME=secret-name  or  ENV_NAME=projects/<project>/secrets/<name>[/versions/<v>]
# bin/with-secrets reads this to inject them from Google Secret Manager.
# The config module ({{CONFIG_MODULE_PATH}}) declares and validates each one.

{{ENV_NAME}}={{secret-name}}
