#!/usr/bin/env bash
# with-secrets: run a command with secrets from the project's vault set as environment variables.
# Values are fetched at run time and never printed, logged or written to disk.
#
# Usage: bin/with-secrets <command> [args...]
#   bin/with-secrets npm run dev
#   bin/with-secrets bin/verify --full
#
# Reads .shipyard/secrets.list: one ENV_NAME=secret-ref per line. secret-ref is either a secret
# name in the default project, or projects/<project>/secrets/<name>[/versions/<version>].
# The version defaults to latest. The default project is $GOOGLE_CLOUD_PROJECT, else gcloud's.
# Variables already set are left alone, so CI and Cloud Run can inject them directly.
# Needs gcloud logged in on this machine (gcloud auth login, or application-default login).
#
# Infisical instead of Secret Manager: put "vault = infisical" in .shipyard/config, plus optional
# "infisical_args = --env=dev --path=/api". This then runs: infisical run <infisical_args> -- <command>.
# Infisical injects the values itself, so .shipyard/secrets.list isn't needed.

{ set +x; } 2>/dev/null   # never trace this script: a trace would print the values
set -euo pipefail

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }
[ $# -gt 0 ] || { usage >&2; exit 2; }
case "$1" in -h|--help) usage; exit 0 ;; esac

root="$(cd "$(dirname "$0")/.." && pwd)"
cfg() { [ -f "$root/.shipyard/config" ] && sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$root/.shipyard/config" | tail -n 1 | sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//'; }
if [ "$(cfg vault)" = "infisical" ]; then
  command -v infisical >/dev/null 2>&1 || { echo "with-secrets: the infisical CLI isn't installed" >&2; exit 1; }
  # shellcheck disable=SC2046  # infisical_args is a list of flags
  exec infisical run $(cfg infisical_args) -- "$@"
fi
list="$root/.shipyard/secrets.list"
if [ ! -f "$list" ]; then
  echo "with-secrets: no .shipyard/secrets.list, running without secrets" >&2
  exec "$@"
fi
command -v gcloud >/dev/null 2>&1 || { echo "with-secrets: gcloud isn't installed or isn't on PATH" >&2; exit 1; }

while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="$(printf '%s' "$line" | tr -d '[:space:]')"
  [ -z "$line" ] && continue
  name="${line%%=*}"
  ref="${line#*=}"
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "with-secrets: bad variable name in secrets.list: $name" >&2; exit 1; }
  [ -n "${!name+x}" ] && continue

  secret="$ref" version="latest" project_args=()
  [ -n "${GOOGLE_CLOUD_PROJECT:-}" ] && project_args=(--project "$GOOGLE_CLOUD_PROJECT")
  if [[ "$ref" == projects/* ]]; then
    IFS=/ read -r _ proj _ secret _ ver <<<"$ref"
    project_args=(--project "$proj")
    [ -n "${ver:-}" ] && version="$ver"
  fi

  if ! value="$(gcloud secrets versions access "$version" --secret="$secret" ${project_args[@]+"${project_args[@]}"} 2>/dev/null)"; then
    echo "with-secrets: couldn't read secret '$secret' for $name. Check it exists in Secret Manager and that gcloud is logged in." >&2
    exit 1
  fi
  export "$name=$value"
done <"$list"

unset value
exec "$@"
