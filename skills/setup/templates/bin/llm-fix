#!/usr/bin/env bash
# llm-fix: have a cheaper model fix lint problems in one file, and nothing else.
#
# Usage: bin/llm-fix <file> "<linter output>"
#
# The model may only read and edit that one file. If anything else in the working tree
# changes, the change is rolled back and this exits 1.
# Pick the model with SHIPINETICS_FIX_CLI:
#   claude  (default) claude -p with SHIPINETICS_FIX_MODEL (default sonnet)
#   cursor  cursor-agent with SHIPINETICS_FIX_MODEL (e.g. a Composer model)
# Effort for the claude CLI: SHIPINETICS_FIX_EFFORT (default high; set it empty for the model's default).

set -euo pipefail
cd "$(dirname "$0")/.."

file="${1:?usage: bin/llm-fix <file> <lint output>}"
errors="${2:?usage: bin/llm-fix <file> <lint output>}"
[ -f "$file" ] || { echo "llm-fix: no such file: $file" >&2; exit 1; }

prompt="Fix these lint problems in $file. Change only what's needed to fix them. Keep behavior identical. Don't touch any other file, don't add disable comments, and don't change tests to make them pass.

Linter output:
$errors"

before="$(git status --porcelain | grep -v -F " $file" || true)"
backup="$(mktemp "${TMPDIR:-/tmp}/llm-fix.XXXXXX")"; cp "$file" "$backup"
trap 'rm -f "$backup"' EXIT

case "${SHIPINETICS_FIX_CLI:-claude}" in
  claude) fx="${SHIPINETICS_FIX_EFFORT-high}"; claude -p --model "${SHIPINETICS_FIX_MODEL:-sonnet}" ${fx:+--effort "$fx"} --tools "Read,Edit" --permission-mode acceptEdits "$prompt" >/dev/null ;;
  cursor) cursor-agent -p --force ${SHIPINETICS_FIX_MODEL:+--model "$SHIPINETICS_FIX_MODEL"} "$prompt" >/dev/null ;;
  *) echo "llm-fix: unknown SHIPINETICS_FIX_CLI" >&2; exit 1 ;;
esac

after="$(git status --porcelain | grep -v -F " $file" || true)"
if [ "$before" != "$after" ]; then
  echo "llm-fix: the model changed files other than $file. Restoring $file. Check git status for the rest." >&2
  cp "$backup" "$file"
  exit 1
fi
