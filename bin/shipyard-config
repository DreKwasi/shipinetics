#!/usr/bin/env bash
# shipyard-config: show this project's Shipyard settings (paths, commands, mode).
#
# Usage:
#   shipyard-config              print every setting, marking the ones the project sets itself
#   shipyard-config get <key>    print one value (the project's, else the default)
#   shipyard-config root         print the Shipyard root (the folder that holds .shipyard/)
#
# Skills and tools use these values in place of their default paths.

set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$here/scripts/lib.sh"

root="$(sy_root "$PWD")" || { echo "shipyard-config: no .shipyard/ folder here or above. Run /shipyard:setup first." >&2; exit 1; }

case "${1:-}" in
  get) [ -n "${2:-}" ] || { echo "usage: shipyard-config get <key>" >&2; exit 2; }; sy_cfg "$root" "$2" ;;
  root) echo "$root" ;;
  ""|list)
    echo "root: $root"
    if sy_workspace "$root"; then echo "mode: workspace (packages: $(sy_cfg "$root" packages))"; else echo "mode: single repo"; fi
    for k in $SY_KEYS; do
      v="$(sy_cfg "$root" "$k")"
      if sy_is_set "$root" "$k"; then mark="set"; else mark="default"; fi
      printf '%-24s %-8s %s\n' "$k" "$mark" "${v:-(none)}"
    done
    ;;
  -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "shipyard-config: unknown command: $1" >&2; exit 2 ;;
esac
