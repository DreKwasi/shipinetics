#!/usr/bin/env bash
# worksheet: create, find and tag session worksheets.
#
# Usage:
#   worksheet new <slug> ["Title"]   create a worksheet for today and make it current
#   worksheet current                print the current worksheet's path
#   worksheet use <name>             make an existing worksheet current (to resume someone else's)
#   worksheet list                   list worksheets with their one-line summaries
#   worksheet tag [name]             tag HEAD of the current repo for the worksheet
#
# Where worksheets live and how they're tagged come from .shipinetics/config (see shipinetics-config).
# If the project has its own scripts (worksheet_new_cmd, worksheet_tag_cmd), this hands off to them,
# so one command works the same in every project.
# Commits made under a worksheet should carry a trailer line: "Worksheet: <name>" unless the project
# records worksheets another way (package_worksheets_dir).

set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$here/scripts/lib.sh"
die() { echo "worksheet: $*" >&2; exit 1; }

root="$(sy_root "$PWD" || git rev-parse --show-toplevel 2>/dev/null)" || die "run this inside a Shipinetics project or a git repo"
dir="$root/$(sy_cfg "$root" worksheets_dir)"
state="$root/.shipinetics/.cache/current-worksheet"
mkdir -p "$dir" "$root/.shipinetics/.cache"
name_of() { basename "$1" .md; }

cmd="${1:-}"; shift || true
case "$cmd" in
  new)
    slug="${1:-}"; [ -n "$slug" ] || die "usage: worksheet new <slug> [\"Title\"]"
    case "$slug" in *[!a-z0-9-]*) die "slug must be lowercase letters, digits and dashes" ;; esac
    custom="$(sy_cfg "$root" worksheet_new_cmd)"
    if [ -n "$custom" ]; then
      path="$(cd "$root" && sh -c "$custom \"\$1\"" _ "$slug" | tail -n 1)"
      case "$path" in /*) ;; *) path="$root/$path" ;; esac
      [ -f "$path" ] || die "$custom didn't print a worksheet path (got: $path)"
    else
      title="${2:-$slug}"
      name="$(date +%Y-%m-%d)-$slug"
      path="$dir/$name.md"
      [ -e "$path" ] && die "$path already exists. Use: worksheet use $name"
      tpl="$dir/_template.md"; [ -f "$tpl" ] || tpl="$here/skills/worksheet/template.md"
      content="$(cat "$tpl")"
      content="${content//"{{NAME}}"/$name}"
      content="${content//"{{TITLE}}"/$title}"
      content="${content//"{{DATE}}"/$(date '+%Y-%m-%d %H:%M')}"
      content="${content//"{{BRANCH}}"/$(git -C "$PWD" branch --show-current 2>/dev/null || echo none)}"
      content="${content//"{{BASE}}"/$(git -C "$PWD" rev-parse --short HEAD 2>/dev/null || echo none)}"
      printf '%s\n' "$content" >"$path"
    fi
    printf '%s' "$path" >"$state"
    echo "$path"
    ;;
  current)
    [ -f "$state" ] && [ -f "$(cat "$state")" ] || die "no current worksheet. Start one with: worksheet new <slug>"
    cat "$state"; echo
    ;;
  use)
    n="${1:-}"; [ -n "$n" ] || die "usage: worksheet use <name>"
    path="$dir/${n%.md}.md"; [ -f "$path" ] || die "no worksheet at $path"
    printf '%s' "$path" >"$state"; echo "$path"
    ;;
  list)
    for f in "$dir"/*.md; do
      [ -e "$f" ] || continue
      [ "$(basename "$f")" = "_template.md" ] && continue
      summary="$(grep -m1 -iE '^> ?summary|^summary:' "$f" | sed -E 's/^> ?//; s/^[Ss]ummary:? *//')"
      printf '%s  %s\n' "$(name_of "$f")" "$summary"
    done
    ;;
  tag)
    if [ -n "${1:-}" ]; then path="$dir/${1%.md}.md"; else
      [ -f "$state" ] || die "no current worksheet and no name given"
      path="$(cat "$state")"
    fi
    [ -f "$path" ] || die "no worksheet at $path"
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run worksheet tag inside the git repo you committed to"
    custom="$(sy_cfg "$root" worksheet_tag_cmd)"
    if [ -n "$custom" ]; then
      pkg="$(sy_package_of "$root" "$(sy_rel "$root" "$repo")" || true)"
      relpath="$(sy_rel "$root" "$path")"
      (cd "$root" && sh -c "$custom ${pkg:+\"\$1\"} \"\$2\"" _ "$pkg" "$relpath")
    else
      name="$(name_of "$path")"; tag="$(sy_cfg "$root" tag_prefix)$name"
      [ -z "$(git status --porcelain)" ] || echo "worksheet: warning: uncommitted changes won't be in the tag. Commit first." >&2
      git tag -a "$tag" -m "$(head -n 7 "$path")" || die "tag $tag exists. Delete it first if you mean to move it."
      echo "$tag -> $(git rev-parse --short HEAD)"
    fi
    ;;
  ""|-h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try --help)" ;;
esac
