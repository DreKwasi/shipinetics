#!/usr/bin/env bash
# shipinetics-config: show this project's Shipinetics settings (paths, commands, mode).
#
# Usage:
#   shipinetics-config              print every setting, marking the ones the project sets itself
#   shipinetics-config get <key>    print one value (the project's, else the default)
#   shipinetics-config root         print the Shipinetics root (the folder that holds .shipinetics/)
#   shipinetics-config due security-audit
#                                   whether the scheduled full security audit is due, from
#                                   security_audit_every and the last line in docs/security/audits.md.
#                                   Exit 0 if due, 1 if not yet, 2 if it isn't scheduled
#   shipinetics-config match <list> <path>
#                                   which glob in a list (protected-paths, test-paths,
#                                   ui-paths) matches the path,
#                                   exactly as the guards match it. Exit 1 if none
#   shipinetics-config pending      list proposed changes to protected files (.shipinetics/pending/)
#   shipinetics-config apply [path...]
#                                   review each proposal as a diff and apply it or not. Needs a
#                                   human at a terminal, so an agent's Bash tool can't run it
#                                   (a speed bump, not a lock).
#   shipinetics-config -C <dir> <command>
#                                   run the command for the project in <dir>, like git -C
#
# A proposal is the full new version of a file at .shipinetics/pending/<path>. To propose deleting
# files, list their paths (relative to the root, one on each line) in .shipinetics/pending/.delete.
# Skills and tools use these values in place of their default paths.

set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$here/scripts/lib.sh"

# epoch_of <YYYY-MM-DD>: seconds since 1970 at that date (BSD and GNU date)
epoch_of() { date -j -f '%Y-%m-%d %H:%M:%S' "$1 00:00:00" +%s 2>/dev/null || date -d "$1" +%s; }

# due security-audit: see the usage above
due() {
  local every days log last age
  [ "${1:-}" = security-audit ] || { echo "usage: shipinetics-config due security-audit" >&2; exit 2; }
  every="$(sy_cfg "$root" security_audit_every)"
  case "$every" in
    off|"") echo "security-audit: not scheduled (security_audit_every = off)"; exit 2 ;;
    weekly) days=7 ;; monthly) days=30 ;; quarterly) days=91 ;;
    *[0-9]d) days="${every%d}" ;;
    *) echo "shipinetics-config: security_audit_every must be off, weekly, monthly, quarterly or <days>d, not '$every'" >&2; exit 2 ;;
  esac
  case "$days" in ''|*[!0-9]*) echo "shipinetics-config: bad security_audit_every: $every" >&2; exit 2 ;; esac
  log="$root/docs/security/audits.md"
  last="$(grep -oE '^- [0-9]{4}-[0-9]{2}-[0-9]{2}' "$log" 2>/dev/null | cut -c3- | sort | tail -n 1 || true)"
  if [ -z "$last" ]; then echo "security-audit: due (never run; every $every)"; exit 0; fi
  age=$(( ( $(date +%s) - $(epoch_of "$last") ) / 86400 ))
  if [ "$age" -ge "$days" ]; then echo "security-audit: due (last run $last, $age days ago; every $every)"; exit 0; fi
  echo "security-audit: not due (last run $last, $age days ago; due in $((days - age)) days)"; exit 1
}

# proposals [path...]: "<proposal file>\t<target path relative to root>" for each pending change
proposals() {
  local dir f t
  dir="$(sy_dir "$root")/pending"
  [ -d "$dir" ] || return 0
  find "$dir" -type f | LC_ALL=C sort | while IFS= read -r f; do
    t="${f#"$dir"/}"
    [ "$t" = .delete ] && continue
    if [ $# -gt 0 ]; then
      case " $* " in *" $t "*|*" $root/$t "*) ;; *) continue ;; esac
    fi
    printf '%s\t%s\n' "$f" "$t"
  done
}

# strip_comment: stdin line without its comment and outer blanks. "#" starts a comment at the start
# of a line or after a blank, so a path can contain "#".
strip_comment() { sed -e 's/^#.*//' -e 's/[[:space:]]#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

# inside_root <path relative to root>: true if the path's folder, with every symlink resolved, is the
# root or inside it. Checked again just before each write or delete, because a folder can change
# while the human reads the diff.
inside_root() {
  local d r base="${2:-$root}"
  d="$(dirname "$base/$1")"
  # A folder that doesn't exist yet can't be a symlink: check the nearest one that exists.
  while [ ! -d "$d" ] && [ ! -L "$d" ]; do d="$(dirname "$d")"; done
  d="$(cd "$d" 2>/dev/null && pwd -P)" || return 1
  r="$(cd "$base" && pwd -P)"
  case "$d/" in "$r/"*) return 0 ;; esac
  return 1
}

# dest_base <path relative to the root>: the folder that a change to it goes to. In a git worktree, .shipinetics/ is
# a copy of the main checkout's, so a change to it goes to the main checkout, and the copy follows.
dest_base() {
  case "$1" in "$SY_DIR_NAME"/*)
    if [ -f "$(sy_dir "$root")/.copied-from" ]; then head -n 1 "$(sy_dir "$root")/.copied-from"; return 0; fi ;;
  esac
  printf '%s\n' "$root"
}

# deletions [path...]: each path in the .delete list, one per line, that is safe to act on: relative,
# inside the root once symlinks are resolved, with no . or .. part. Comments and blank lines are skipped.
deletions() {
  local list p b
  list="$(sy_dir "$root")/pending/.delete"
  [ -f "$list" ] || return 0
  while IFS= read -r p || [ -n "$p" ]; do
    p="$(printf '%s\n' "$p" | strip_comment)"
    [ -n "$p" ] || continue
    case "/$p/" in //*|*/../*|*/./*) echo "shipinetics-config: skipped '$p' in $SY_DIR_NAME/pending/.delete: use a path relative to the root, without . or .. parts" >&2; continue ;; esac
    b="$(dest_base "$p")"
    if ! inside_root "$p" "$b"; then echo "shipinetics-config: skipped '$p' in $SY_DIR_NAME/pending/.delete: a folder on its path leads outside $b" >&2; continue; fi
    if [ $# -gt 0 ]; then
      case " $* " in *" $p "*|*" $root/$p "*) ;; *) continue ;; esac
    fi
    printf '%s\n' "$p"
  done <"$list"
}

# drop_deletion <path>: remove the lines for one path from the .delete list (compared without
# comments and blanks, as deletions reads them), and the list when nothing is left in it
drop_deletion() {
  local list line p rest=""
  list="$(sy_dir "$root")/pending/.delete"
  [ -f "$list" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    p="$(printf '%s\n' "$line" | strip_comment)"
    [ "$p" = "$1" ] && continue
    rest="$rest$line
"
  done <"$list"
  if printf '%s' "$rest" | strip_comment | grep -q '.'; then printf '%s' "$rest" >"$list"; else rm -f "$list"; fi
}

list_pending() {
  local f t b n=0
  while IFS="$(printf '\t')" read -r f t; do
    n=$((n + 1))
    if [ ! -e "$root/$t" ]; then echo "$t (new file)"
    elif cmp -s "$f" "$root/$t"; then echo "$t (same as the current file)"
    else echo "$t (+$(diff "$root/$t" "$f" | grep -c '^>') -$(diff "$root/$t" "$f" | grep -c '^<') lines)"; fi
  done < <(proposals)
  while IFS= read -r t; do
    n=$((n + 1))
    b="$(dest_base "$t")"
    if [ -e "$b/$t" ] || [ -L "$b/$t" ]; then echo "$t (delete)"; else echo "$t (delete; already gone)"; fi
  done < <(deletions)
  if [ "$n" -gt 0 ]; then
    echo
    why_apply
    echo
    echo "Run this command in your own terminal:"
    echo "  $(apply_cmd)"
    if ! has_shim; then
      echo
      echo "To use the short command 'shipinetics-config' in your terminal from now on, run this once:"
      printf '  %q install\n' "$here/bin/shipinetics-shims"
    fi
  else
    echo "No pending changes."
  fi
}

# why_apply: the reason that a person, not an agent, applies a proposal
why_apply() {
  echo "Why you must apply these changes yourself:"
  echo "- Each file is protected. Protected files hold the rules that check the agent's work: acceptance tests, baselines, policy lists and Claude Code's settings."
  echo "- The edit guard stops agents from changing a protected file. So an agent cannot change a rule to make its own work pass."
  echo "- An agent wrote each new version to $SY_DIR_NAME/pending/. You read each diff and decide. Nothing changes until you say yes."
  echo "- The apply command needs a terminal, so an agent cannot run it for you."
  if ! has_shim; then
    echo "- The command uses the full path because your terminal does not have the plugin's tools on its PATH. The path contains the plugin version, so it changes after each update."
  fi
}

# has_shim: shipinetics-shims wrote a shipinetics-config shim, so the short name works in the
# user's terminal (when the shim folder is on their PATH)
has_shim() {
  grep -qF "# Written by shipinetics-shims." "${SHIPINETICS_SHIM_DIR:-$HOME/.local/bin}/shipinetics-config" 2>/dev/null
}

# apply_cmd: the exact command that a person runs in their own terminal
apply_cmd() {
  if has_shim; then printf 'shipinetics-config -C %q apply' "$root"
  else printf '%q -C %q apply' "$here/bin/shipinetics-config" "$root"; fi
}

apply_pending() {
  local f t reply applied=0 dir dest
  if [ ! -t 0 ]; then
    {
      echo "shipinetics-config: apply needs a person at a terminal, so an agent cannot run it."
      echo "List the changes with: shipinetics-config pending"
      echo "Then give the user its output. It says why they must apply the changes, and it gives the exact command."
    } >&2
    exit 1
  fi
  why_apply
  echo
  dir="$(sy_dir "$root")/pending"
  while IFS="$(printf '\t')" read -r f t <&3; do
    echo "== $t"
    # In a git worktree, .shipinetics/ is a copy of the main checkout's. A change to it goes to the
    # main checkout, and the worktree's copy follows on the next run.
    base="$(dest_base "$t")"; dest="$base/$t"
    if [ -L "$dest" ]; then echo "$dest is a symlink, so apply this one by hand."; continue; fi
    if [ -e "$dest" ]; then diff -u --label "$t (current)" --label "$t (proposed)" "$dest" "$f" || true
    else echo "(new file)"; sed 's/^/+ /' "$f"; fi
    [ "$dest" = "$root/$t" ] || echo "(This changes the main checkout's file: $dest)"
    printf 'Apply this change to %s? [y/N/q] ' "$t"
    read -r reply || reply=q
    case "$reply" in
      y|Y|yes)
        if ! inside_root "$t" "$base" || [ -L "$dest" ]; then echo "$t now leads outside $base, or is a symlink, so it is left pending."; continue; fi
        mkdir -p "$(dirname "$dest")"
        if cat "$f" >"$dest" && rm -f "$f"; then applied=$((applied + 1)); echo "applied."; else echo "could not write $t, so it is left pending."; fi ;;
      q|Q) break ;;
      *) echo "left pending." ;;
    esac
  done 3< <(proposals "$@")
  # Deletions come after the new versions, and only when the user didn't quit.
  if [ "${reply:-}" != q ] && [ "${reply:-}" != Q ]; then
    while IFS= read -r t <&3; do
      echo "== $t (delete)"
      base="$(dest_base "$t")"; dest="$base/$t"
      if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then echo "already gone."; drop_deletion "$t"; continue; fi
      if [ -d "$dest" ] && [ ! -L "$dest" ]; then echo "$dest is a folder, so delete it by hand."; continue; fi
      [ "$dest" = "$root/$t" ] || echo "(This deletes the main checkout's file: $dest)"
      echo "Current content (first 20 lines):"; sed -n '1,20p' "$dest" | sed 's/^/- /'
      printf 'Delete %s? [y/N/q] ' "$t"
      read -r reply || reply=q
      case "$reply" in
        y|Y|yes)
          if ! inside_root "$t" "$base"; then echo "$t now leads outside $base, so it is left pending."; continue; fi
          if rm -f "$dest" && [ ! -e "$dest" ] && [ ! -L "$dest" ]; then drop_deletion "$t"; applied=$((applied + 1)); echo "deleted."
          else echo "could not delete $t, so it is left pending."; fi ;;
        q|Q) break ;;
        *) echo "left pending." ;;
      esac
    done 3< <(deletions "$@")
  fi
  find "$dir" -depth -type d -empty -delete 2>/dev/null || true
  echo "$applied applied. Review with git diff and commit."
}

# -C <dir>: run as if started in <dir>, like git -C. A relative path in "match" counts from <dir> too.
if [ "${1:-}" = -C ]; then
  [ -n "${2:-}" ] || { echo "usage: shipinetics-config -C <project folder> <command>" >&2; exit 2; }
  cd "$2" 2>/dev/null || { echo "shipinetics-config: can't open the folder $2" >&2; exit 2; }
  shift 2
fi

root="$(sy_root "$PWD")" || {
  echo "shipinetics-config: $(sy_wt_hint "$PWD" || echo "no .shipinetics/ folder in $PWD or above. Run /shipinetics:setup first.")" >&2; exit 1; }

case "${1:-}" in
  get)
    [ -n "${2:-}" ] || { echo "usage: shipinetics-config get <key>" >&2; exit 2; }
    sy_cfg "$root" "$2" ;;
  root) echo "$root" ;;
  due) shift; due "$@" ;;
  match)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: shipinetics-config match <list> <path>" >&2; exit 2; }
    l="${2##*/}"
    [ -f "$(sy_dir "$root")/$l" ] || { echo "shipinetics-config: there's no $SY_DIR_NAME/$l" >&2; exit 2; }
    case "$3" in /*) p="$3" ;; *) p="$PWD/$3" ;; esac
    rel="$(sy_rel "$root" "$(sy_norm_path "$p")")"
    if sy_list_match "$root" "$l" "$rel"; then echo "$rel matches '$SY_MATCHED' in $l"
    else
      case "$rel" in "$SY_DIR_NAME/pending/"*) [ "$l" = protected-paths ] && echo "$rel is a pending proposal, which is never protected" && exit 1 ;; esac
      echo "$rel matches nothing in $l"; exit 1
    fi ;;
  pending) list_pending ;;
  apply) shift; apply_pending "$@" ;;
  ""|list)
    echo "root: $root"
    if [ -f "$(sy_dir "$root")/.copied-from" ]; then
      echo "settings: copied from $(head -n 1 "$(sy_dir "$root")/.copied-from"), because this is a git worktree. Change them there."
    fi
    if sy_workspace "$root"; then
      echo "mode: workspace (packages: $(sy_cfg "$root" packages))"
      if h="$(sy_harness_repo "$root")"; then echo "harness files versioned in: $h"
      else echo "warning: the root isn't a git repo and harness_repo isn't set, so .shipinetics/, the queue and the root's docs aren't versioned. Run /shipinetics:setup to fix it."; fi
    else echo "mode: single repo"; fi
    for k in $SY_KEYS; do
      v="$(sy_cfg "$root" "$k")"
      if sy_is_set "$root" "$k"; then mark="set"; else mark="default"; fi
      printf '%-24s %-8s %s\n' "$k" "$mark" "${v:-(none)}"
    done
    ;;
  -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "shipinetics-config: unknown command: $1" >&2; exit 2 ;;
esac
