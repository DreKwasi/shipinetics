#!/usr/bin/env bash
# shipinetics-config: show this project's Shipinetics settings (paths, commands, mode).
#
# Usage:
#   shipinetics-config              print every setting, marking the ones the project sets itself
#   shipinetics-config get <key>    print one value (the project's, else the default)
#   shipinetics-config root         print the Shipinetics root (the folder that holds .shipinetics/)
#   shipinetics-config migrate [--dry-run]
#                                   move a project set up under the old Shipyard name to the new
#                                   names: .shipyard/ becomes .shipinetics/, and SHIPYARD_* variables,
#                                   shipyard-verify, shipyard-config and shipyard:<skill or agent>
#                                   references in the project's files are rewritten. Leaves the
#                                   changes uncommitted for you to review. See MIGRATING.md.
#   shipinetics-config pending      list proposed changes to protected files (.shipinetics/pending/)
#   shipinetics-config apply [path...]
#                                   review each proposal as a diff and apply it or not. Needs a
#                                   human at a terminal, so an agent can't apply its own proposals.
#
# Skills and tools use these values in place of their default paths.

set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$here/scripts/lib.sh"

# migrate [--dry-run]: see the usage above
migrate() {
  local dry=0 force=0 a old new repos=() r f n=0 changed=()
  for a in "$@"; do
    case "$a" in --dry-run) dry=1 ;; --force) force=1 ;; *) echo "usage: shipinetics-config migrate [--dry-run] [--force]" >&2; exit 2 ;; esac
  done
  old="$root/$SY_LEGACY_DIR_NAME" new="$root/$SY_DIR_NAME"
  [ -d "$old" ] && [ -d "$new" ] && { echo "shipinetics-config: both $old and $new exist. Merge them by hand, then run migrate again." >&2; exit 1; }

  # The repos to rewrite: the root's own (if it has one) and each package repo in workspace mode.
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then repos+=("$root"); fi
  for r in $(sy_cfg "$root" packages); do
    [ -e "$root/$r/.git" ] && repos+=("$root/$r")
  done
  if [ "$force" = 0 ] && [ "$dry" = 0 ]; then
    for r in ${repos[@]+"${repos[@]}"}; do
      [ -z "$(git -C "$r" status --porcelain -- . 2>/dev/null)" ] ||
        { echo "shipinetics-config: $r has uncommitted changes. Commit or stash them first, so the migration is its own diff (or pass --force)." >&2; exit 1; }
    done
  fi

  # move <from> <to>: git mv when the path is tracked, else mv
  move() {
    if [ "$dry" = 1 ]; then echo "would move ${1#"$root"/} to ${2#"$root"/}"; return; fi
    if git -C "$(dirname "$1")" ls-files --error-unmatch "$1" >/dev/null 2>&1; then git -C "$(dirname "$1")" mv "$1" "$2"
    else mv "$1" "$2"; fi
    echo "moved ${1#"$root"/} to ${2#"$root"/}"
  }
  [ -d "$old" ] && move "$old" "$new"
  [ -f "$root/docs/shipyard-setup.md" ] && [ ! -e "$root/docs/shipinetics-setup.md" ] &&
    move "$root/docs/shipyard-setup.md" "$root/docs/shipinetics-setup.md"

  # Text files that name the old folder, commands, variables or skills.
  local re='SHIPYARD_|shipyard-(verify|config)|shipyard:|[.]shipyard([^a-zA-Z0-9_-]|$)|shipyard-setup[.]md'
  list_files() {
    local r
    for r in ${repos[@]+"${repos[@]}"}; do
      git -C "$r" grep -lIE "$re" -- . ":(exclude)$SY_DIR_NAME/.cache" ":(exclude)$SY_LEGACY_DIR_NAME/.cache" 2>/dev/null | sed "s|^|$r/|"
    done
    # A workspace root that isn't a repo: its own files, outside the package repos.
    if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      local ex=() p
      for p in $(sy_cfg "$root" packages) .git node_modules .cache; do ex+=(--exclude-dir="$p"); done
      grep -rlIE "${ex[@]}" "$re" "$root" 2>/dev/null
    fi
  }
  while IFS= read -r f; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    if [ "$dry" = 0 ]; then
      perl -pi -e 's/SHIPYARD_/SHIPINETICS_/g; s/shipyard-(verify|config)\b/shipinetics-$1/g; s/\bshipyard:/shipinetics:/g; s/\.shipyard(?![\w-])/.shipinetics/g; s/shipyard-setup\.md/shipinetics-setup.md/g' "$f"
    fi
    changed+=("${f#"$root"/}"); n=$((n + 1))
  done < <(list_files | sort -u)

  if [ "$n" -gt 0 ]; then
    if [ "$dry" = 1 ]; then echo "would update $n files:"; else echo "updated $n files:"; fi
    printf '  %s\n' "${changed[@]}"
  fi
  [ "$dry" = 1 ] && return 0
  echo "Review the changes (git diff), then commit them. Rename any SHIPYARD_* variables you set outside the repo too: your shell profile, CI settings."
}

# proposals [path...]: "<proposal file>\t<target path relative to root>" for each pending change
proposals() {
  local dir f t
  dir="$(sy_dir "$root")/pending"
  [ -d "$dir" ] || return 0
  find "$dir" -type f | LC_ALL=C sort | while IFS= read -r f; do
    t="${f#"$dir"/}"
    if [ $# -gt 0 ]; then
      case " $* " in *" $t "*|*" $root/$t "*) ;; *) continue ;; esac
    fi
    printf '%s\t%s\n' "$f" "$t"
  done
}

list_pending() {
  local f t n=0
  while IFS="$(printf '\t')" read -r f t; do
    n=$((n + 1))
    if [ ! -e "$root/$t" ]; then echo "$t (new file)"
    elif cmp -s "$f" "$root/$t"; then echo "$t (same as the current file)"
    else echo "$t (+$(diff "$root/$t" "$f" | grep -c '^>') -$(diff "$root/$t" "$f" | grep -c '^<') lines)"; fi
  done < <(proposals)
  [ "$n" -gt 0 ] && echo "Review and apply them with: shipinetics-config apply" || echo "No pending changes."
}

apply_pending() {
  local f t reply applied=0 dir
  [ -t 0 ] || { echo "shipinetics-config: apply needs a human at a terminal. Pending changes are for a person to review; an agent can list them with: shipinetics-config pending" >&2; exit 1; }
  dir="$(sy_dir "$root")/pending"
  while IFS="$(printf '\t')" read -r f t <&3; do
    echo "== $t"
    if [ -e "$root/$t" ]; then diff -u --label "$t (current)" --label "$t (proposed)" "$root/$t" "$f" || true
    else echo "(new file)"; sed 's/^/+ /' "$f"; fi
    printf 'Apply this change to %s? [y/N/q] ' "$t"
    read -r reply || reply=q
    case "$reply" in
      y|Y|yes)
        mkdir -p "$(dirname "$root/$t")"
        cat "$f" >"$root/$t" && rm -f "$f" && applied=$((applied + 1))
        echo "applied." ;;
      q|Q) break ;;
      *) echo "left pending." ;;
    esac
  done 3< <(proposals "$@")
  find "$dir" -depth -type d -empty -delete 2>/dev/null || true
  echo "$applied applied. Review with git diff and commit."
}

root="$(sy_root "$PWD")" || { echo "shipinetics-config: no .shipinetics/ folder here or above. Run /shipinetics:setup first." >&2; exit 1; }

case "${1:-}" in
  get) [ -n "${2:-}" ] || { echo "usage: shipinetics-config get <key>" >&2; exit 2; }; sy_cfg "$root" "$2" ;;
  root) echo "$root" ;;
  migrate) shift; migrate "$@" ;;
  pending) list_pending ;;
  apply) shift; apply_pending "$@" ;;
  ""|list)
    echo "root: $root"
    if sy_workspace "$root"; then echo "mode: workspace (packages: $(sy_cfg "$root" packages))"; else echo "mode: single repo"; fi
    for k in $SY_KEYS; do
      v="$(sy_cfg "$root" "$k")"
      if sy_is_set "$root" "$k"; then mark="set"; else mark="default"; fi
      printf '%-24s %-8s %s\n' "$k" "$mark" "${v:-(none)}"
    done
    ;;
  -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "shipinetics-config: unknown command: $1" >&2; exit 2 ;;
esac
