#!/usr/bin/env bash
# shipinetics-shims: short commands for the Shipinetics tools in your own terminal.
#
# The plugin puts its tools on the PATH of Claude Code's Bash tool only. In your own terminal you
# need the full path, and that path contains the plugin version, so it changes after each update.
# A shim is a small script with the tool's name in a folder on your PATH. It finds the installed
# plugin each time it runs, so it keeps working after an update.
#
# Usage:
#   shipinetics-shims install   write a shim for each shipinetics-* tool to the shim folder
#   shipinetics-shims status    list each shim and the plugin folder that the shims use. Exit 1 if
#                               a shim is missing
#   shipinetics-shims remove    remove the shims that this tool wrote
#   shipinetics-shims auto      what the session-start hook runs: install or refresh the shims
#                               only if the shim folder is on the PATH, and say nothing unless it
#                               wrote a shim. Switch it off with "hooks_off = shims"
#
# The shim folder is ~/.local/bin, or $SHIPINETICS_SHIM_DIR. A shim finds the plugin in this order:
#   1. $SHIPINETICS_HOME (a plugin folder or a clone)
#   2. the installPath of shipinetics in Claude Code's plugins/installed_plugins.json
#      (user scope first)
#   3. ~/.gemini/config/plugins/shipinetics (Antigravity)
# The shims cover the shipinetics-* tools only. The other tools (evidence, worksheet and others)
# have common names, so a shim could hide another program with the same name.
# This tool never changes a file that it didn't write.

set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
shim_dir="${SHIPINETICS_SHIM_DIR:-$HOME/.local/bin}"
marker="# Written by shipinetics-shims. Run 'shipinetics-shims remove' to remove it."

# tools: the names that get a shim, one for each line
tools() {
  local f
  for f in "$here"/bin/shipinetics-*; do
    [ -f "$f" ] && [ -x "$f" ] && basename "$f"
  done
}

# is_ours <file>: the file is a shim that this tool wrote
is_ours() { [ -f "$1" ] && grep -qF "$marker" "$1" 2>/dev/null; }

# shim_text: the same text for each shim. The shim runs the tool that has its own name.
shim_text() {
  cat <<EOF
#!/usr/bin/env bash
$marker
set -eu
name="\$(basename "\$0")"
find_root() {
  if [ -n "\${SHIPINETICS_HOME:-}" ]; then echo "\$SHIPINETICS_HOME"; return; fi
  local list="\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}/plugins/installed_plugins.json" p
  if [ -f "\$list" ]; then
    # python3, or on Windows python or the py launcher
    for py in python3 python "py -3"; do
      p="\$(\$py -c 'import json, sys
data = json.load(open(sys.argv[1]))
plugins = data.get("plugins", data)
entries = []
for key, value in plugins.items():
    if key.split("@")[0] == "shipinetics":
        entries += value if isinstance(value, list) else [value]
entries.sort(key=lambda e: e.get("scope") != "user")
for e in entries:
    if e.get("installPath"):
        print(e["installPath"])
        break' "\$list" 2>/dev/null | tr -d '\r' || true)"
      [ -n "\$p" ] && break
    done
    # Windows: the installed path is C:\\x\\y. Turn it into the form that Git Bash uses.
    [ -n "\$p" ] && command -v cygpath >/dev/null 2>&1 && p="\$(cygpath -u "\$p")"
    if [ -n "\$p" ] && [ -d "\$p" ]; then echo "\$p"; return; fi
  fi
  if [ -d "\$HOME/.gemini/config/plugins/shipinetics" ]; then echo "\$HOME/.gemini/config/plugins/shipinetics"; return; fi
  return 1
}
root="\$(find_root)" || { echo "\$name: can't find the Shipinetics plugin. Install it, or set SHIPINETICS_HOME to its folder." >&2; exit 127; }
[ -x "\$root/bin/\$name" ] || { echo "\$name: \$root/bin/\$name doesn't exist. Update the plugin, or run 'shipinetics-shims remove'." >&2; exit 127; }
exec "\$root/bin/\$name" "\$@"
EOF
}

# on_path <dir>: the folder is on this process's PATH
on_path() { case ":$PATH:" in *":$1:"*) return 0 ;; esac; return 1; }

path_hint() {
  if ! on_path "$shim_dir"; then
    echo
    echo "$shim_dir isn't on the PATH here. If your terminal can't find shipinetics-config, add this line to ~/.zshrc (or ~/.bashrc), then open a new terminal:"
    echo "  export PATH=\"$shim_dir:\$PATH\""
  fi
}

install_shims() {
  local name target n=0 text
  mkdir -p "$shim_dir"
  text="$(shim_text)"
  while read -r name; do
    target="$shim_dir/$name"
    if [ -e "$target" ] && ! is_ours "$target"; then
      echo "skipped $target: a file that shipinetics-shims didn't write is there."
      continue
    fi
    printf '%s\n' "$text" >"$target"
    chmod 755 "$target"
    n=$((n + 1))
  done < <(tools)
  echo "$n shims in $shim_dir. Each one runs the tool from the installed Shipinetics plugin."
  path_hint
}

status_shims() {
  local name target missing=0
  while read -r name; do
    target="$shim_dir/$name"
    if is_ours "$target"; then echo "[shim] $target"
    elif [ -e "$target" ]; then echo "[other] $target: not a shim from shipinetics-shims"; missing=1
    else echo "[missing] $target"; missing=1; fi
  done < <(tools)
  path_hint
  [ "$missing" = 0 ]
}

remove_shims() {
  local f n=0
  for f in "$shim_dir"/shipinetics-*; do
    is_ours "$f" || continue
    rm -f "$f"
    n=$((n + 1))
  done
  echo "removed $n shims from $shim_dir."
}

# auto_shims: like install, but only into a folder on the PATH, and quiet when nothing changed.
# Prints the names of the shims it wrote, one for each line.
auto_shims() {
  local name target text
  on_path "$shim_dir" || return 0
  [ -d "$shim_dir" ] || return 0
  text="$(shim_text)"
  while read -r name; do
    target="$shim_dir/$name"
    if [ -e "$target" ]; then
      is_ours "$target" || continue
      [ "$(cat "$target")" = "$text" ] && continue
    fi
    printf '%s\n' "$text" >"$target" && chmod 755 "$target" && echo "$name"
  done < <(tools)
}

case "${1:-}" in
  install) install_shims ;;
  auto) auto_shims ;;
  status) status_shims ;;
  remove) remove_shims ;;
  *) sed -n '2,/^$/p' "$0" | sed -e '/^$/d' -e 's/^# \{0,1\}//'; exit 2 ;;
esac
