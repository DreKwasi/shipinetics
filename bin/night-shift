#!/usr/bin/env bash
# night-shift: work through the task queue unattended, inside hard limits.
#
# Usage:
#   night-shift [--hours 8] [--budget 40] [--task-budget 8] [--max-turns 150] [--model opus] [--effort high] [--dry-run]
#
# What it does:
#   1. Creates (or resumes) a worktree on branch night/<date> under .claude/worktrees/.
#   2. Loops: one fresh headless Claude run per task, each capped by --task-budget (USD)
#      and --max-turns. Stops when time runs out, the total budget would be exceeded,
#      the queue is empty, or three runs in a row produce no commits.
#   3. Holds back one task budget for a final end-of-shift validation run.
#
# Each task run is a /goal with a fixed completion condition (task done and verified, task blocked
# with a question, queue empty, or a stop request), so a separate evaluator decides when the run
# is finished, inside the hard spend and turn caps.
# Every run appends a row to metrics.csv in the logs folder: outcome, worksheet, cost, turns,
# duration, model, effort and plugin version. The end-of-shift run copies it into the report.
#
# Guardrails: Bash runs in the OS sandbox with no unsandboxed escape, edits are auto-accepted
# only inside the worktree, and pushes, merges, publishes, hard resets, vault reads and credential
# files are denied. CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1 strips credentials from every command.
# Tasks that need secrets get them through bin/with-secrets, which needs sandbox network access
# to secretmanager.googleapis.com and oauth2.googleapis.com.
# It never pushes. You review branch night/<date> when you're back.
# On a laptop, keep the machine awake: caffeinate -i night-shift ...
# Logs: .shipinetics/.cache/night/<date>/ in the main checkout.

set -euo pipefail

hours=8 budget=40 task_budget=8 max_turns=150 model="opus" effort="high" dry=0
plugin_root="$(cd "$(dirname "$0")/.." && pwd)"
plugin_version="$(jq -r '.version // "unknown"' "$plugin_root/.claude-plugin/plugin.json" 2>/dev/null || echo unknown)"
die() { echo "night-shift: $*" >&2; exit 1; }
add() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.4f", a + b }'; }
ge()  { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --hours) hours="$2"; shift 2 ;;
    --budget) budget="$2"; shift 2 ;;
    --task-budget) task_budget="$2"; shift 2 ;;
    --max-turns) max_turns="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

command -v claude >/dev/null || die "claude isn't on PATH"
command -v jq >/dev/null || die "jq is required"
# shellcheck source=../scripts/lib.sh
. "$plugin_root/scripts/lib.sh"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run this inside a git repo"
cd "$root"
sy="$(sy_root "$root")" || die "this repo isn't set up. Run /shipinetics:setup first."
sy_workspace "$sy" && die "workspace mode ($sy) isn't supported by night-shift yet: each package needs its own worktree and verify. Use the project's own night shift process, or set up Shipinetics inside one package repo."
verify_bin="$(sy_cfg "$sy" verify_cmd)"; verify_bin="${verify_bin%% *}"
[ -x "$sy/$verify_bin" ] || command -v "$verify_bin" >/dev/null 2>&1 || die "the verify command ($verify_bin) isn't there. Run /shipinetics:setup first."
[ -z "$(git status --porcelain)" ] || die "commit or stash your changes first, so the shift starts from a known state"

day="$(date +%Y-%m-%d)"
branch="night/$day"
wt="$root/.claude/worktrees/night-$day"
dn="$(sy_dir_name "$sy")"
logs="$root/$dn/.cache/night/$day"
mkdir -p "$logs"

if [ -d "$wt" ]; then
  echo "Resuming worktree $wt"
elif git rev-parse --verify -q "$branch" >/dev/null; then
  git worktree add "$wt" "$branch"
else
  git worktree add -b "$branch" "$wt" HEAD
fi

settings="$logs/settings.json"
cat >"$settings" <<'JSON'
{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": { "allowLocalBinding": true }
  },
  "permissions": {
    "deny": [
      "Bash(git push *)", "Bash(git push)",
      "Bash(git reset --hard *)", "Bash(git clean *)",
      "Bash(git checkout main *)", "Bash(git switch main *)",
      "Bash(gh pr merge *)", "Bash(gh release *)",
      "Bash(npm publish *)", "Bash(pnpm publish *)", "Bash(yarn publish *)",
      "Bash(gcloud secrets versions access *)",
      "Read(~/.config/gcloud/**)", "Read(~/.aws/**)", "Read(~/.ssh/**)"
    ]
  }
}
JSON

run_claude() { # run_claude <prompt> <budget> <log>
  if [ "$dry" = 1 ]; then echo '{"result":"QUEUE_EMPTY (dry run)","total_cost_usd":0}' >"$3"; return 0; fi
  (cd "$wt" && SHIPINETICS_AUTHOR=claude CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1 claude -p "$1" \
    --model "$model" \
    --effort "$effort" \
    --permission-mode acceptEdits \
    --settings "$settings" \
    --max-turns "$max_turns" \
    --max-budget-usd "$2" \
    --output-format json) >"$3" 2>"$3.err" || true
}

metrics="$logs/metrics.csv"
[ -f "$metrics" ] || echo "date,run,outcome,worksheet,cost_usd,turns,duration_s,model,effort,plugin_version" >"$metrics"
record() { # record <run> <outcome> <worksheet> <cost> <turns> <duration_s>
  echo "$day,$1,$2,$3,$4,$5,$6,$model,$effort,$plugin_version" >>"$metrics"
}

task_goal="Use the shipinetics:night-shift skill to take exactly one task from the queue to done or blocked, then stop. The goal is met when the conversation shows one of these: (a) the task is in Done in TODOS.md, bin/verify passes with its output shown, the work and the worksheet are committed with the Worksheet trailer, the worksheet is tagged, and the final message names the task ID and the worksheet; (b) the task is in Blocked with a one-line question for a human, that is committed, and the final message says BLOCKED with the task ID; (c) there are no ready tasks and the final message is QUEUE_EMPTY; (d) something needs a human before any more work can happen and the final message starts with SHIFT_STOP and the reason. Throughout: tests are only written or changed by shipinetics:test-writer, no protected file changes, nothing is pushed. If none of these holds after 5 turns, stop and report the blocker."

start=$(date +%s); end=$((start + $(awk -v h="$hours" 'BEGIN { printf "%d", h * 3600 }')))
spent=0 n=0 idle=0 stop_reason=""

while :; do
  [ "$(date +%s)" -ge "$end" ] && { stop_reason="time limit"; break; }
  left=$(add "$budget" "-$spent")
  ge "$left" "$(add "$task_budget" "$task_budget")" || { stop_reason="budget (holding back one task budget for end of shift)"; break; }

  n=$((n + 1))
  before="$(git -C "$wt" rev-parse HEAD)"
  echo "[$(date +%H:%M)] task run $n (spent \$$spent of \$$budget)"
  t0=$(date +%s)
  run_claude "/goal $task_goal" "$task_budget" "$logs/task-$n.json"
  t1=$(date +%s)

  cost="$(jq -r '.total_cost_usd // 0' "$logs/task-$n.json" 2>/dev/null || echo 0)"
  turns="$(jq -r '.num_turns // 0' "$logs/task-$n.json" 2>/dev/null || echo 0)"
  spent=$(add "$spent" "$cost")
  result="$(jq -r '.result // ""' "$logs/task-$n.json" 2>/dev/null || true)"
  after="$(git -C "$wt" rev-parse HEAD)"
  ws="$(git -C "$wt" log "$before..$after" --format='%(trailers:key=Worksheet,valueonly)' 2>/dev/null | sed '/^$/d' | sort -u | paste -sd ' ' -)"
  case "$result" in
    *QUEUE_EMPTY*) outcome="queue-empty" ;;
    *SHIFT_STOP*)  outcome="stop" ;;
    *BLOCKED*)     outcome="blocked" ;;
    *) if [ "$after" != "$before" ]; then outcome="done"; else outcome="no-commits"; fi ;;
  esac
  record "$n" "$outcome" "${ws:-none}" "$cost" "$turns" "$((t1 - t0))"

  case "$result" in *QUEUE_EMPTY*) stop_reason="queue empty"; break ;; esac
  case "$result" in *SHIFT_STOP*) stop_reason="agent asked to stop: $(printf '%s' "$result" | tail -n 3)"; break ;; esac

  if [ "$(git -C "$wt" rev-parse HEAD)" = "$before" ]; then idle=$((idle + 1)); else idle=0; fi
  [ "$idle" -ge 3 ] && { stop_reason="three runs in a row with no commits"; break; }
done

echo "[$(date +%H:%M)] stopping task loop: $stop_reason. Running end-of-shift validation."
mkdir -p "$wt/$dn/.cache" && cp "$metrics" "$wt/$dn/.cache/night-metrics.csv"
left=$(add "$budget" "-$spent")
eos_budget="$task_budget"; ge "$left" "$task_budget" || eos_budget="$left"
t0=$(date +%s)
run_claude "Use the shipinetics:end-of-shift skill. The task loop stopped because: $stop_reason. Total spend so far: \$$spent. Per-run metrics are in $dn/.cache/night-metrics.csv. Write the shift report." \
  "$eos_budget" "$logs/end-of-shift.json"
eos_cost="$(jq -r '.total_cost_usd // 0' "$logs/end-of-shift.json" 2>/dev/null || echo 0)"
spent=$(add "$spent" "$eos_cost")
record "end-of-shift" "report" "none" "$eos_cost" "$(jq -r '.num_turns // 0' "$logs/end-of-shift.json" 2>/dev/null || echo 0)" "$(( $(date +%s) - t0 ))"

echo
echo "Shift done. Branch: $branch  Worktree: $wt"
echo "Task runs: $n  Estimated spend: \$$spent  Stopped because: $stop_reason"
echo "Report: $wt/docs/shifts/$day.md   Logs: $logs   Metrics: $metrics"
