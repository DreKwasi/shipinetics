#!/usr/bin/env bash
# known-failing: gate a test suite that already has failures, so only new failures fail.
#
# Usage:
#   known-failing check <junit.xml>...   exit 1 if a test failed that isn't on the list. Also names
#                                        listed tests that pass now, so the list can shrink
#   known-failing init <junit.xml>...    write today's failures as the list (a proposal in
#                                        .shipinetics/pending/ if the list already exists)
#   known-failing count                  how many entries the list has
#   known-failing list                   print them
#
# The list is .shipinetics/known-failing: one test ID per line, "#" starts a comment. An ID is
# "<classname>::<name>" from the JUnit report (the file instead of the classname if there's none).
# A line may use * and ? as wildcards. The list is protected (it's under .shipinetics/), so only a
# human adds to it; agents propose changes through .shipinetics/pending/.
# Most runners write JUnit XML: vitest --reporter=junit, jest-junit, pytest --junitxml,
# go-junit-report, cargo nextest, Playwright's junit reporter.
# Without a list, every failure counts. A report with no test cases fails, so a broken runner
# can't pass as "nothing new failed".

set -uo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
# Runs from the plugin, or as a copy in a project's bin/ (CI has no plugin), with just what it needs.
if [ -f "$here/.claude-plugin/plugin.json" ] && [ -f "$here/scripts/lib.sh" ]; then
  # shellcheck source=../scripts/lib.sh
  . "$here/scripts/lib.sh"
else
  sy_root() { local d="$PWD"; while [ ! -d "$d/.shipinetics" ]; do [ "$d" = / ] && return 1; d="$(dirname "$d")"; done; echo "$d"; }
  sy_dir() { echo "$1/.shipinetics"; }
  sy_rel() { case "$2" in "$1"/*) echo "${2#"$1"/}" ;; *) echo "$2" ;; esac; }
  sy_env() { local n="SHIPINETICS_$1"; if [ -n "${!n+x}" ]; then echo "${!n}"; else echo "${2:-}"; fi; }
fi
die() { echo "known-failing: $*" >&2; exit 2; }

root="$(sy_root 2>/dev/null)" || root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
list="$(sy_dir "$root")/known-failing"
command -v python3 >/dev/null 2>&1 || die "python3 is required"

entries() { [ -f "$list" ] && sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$list" | grep -v '^$'; }

# results <junit.xml>...: "<pass|fail>\t<id>" per test case
results() {
  python3 - "$@" <<'PY'
import sys, xml.etree.ElementTree as ET
for path in sys.argv[1:]:
    try:
        tree = ET.parse(path)
    except (OSError, ET.ParseError) as e:
        sys.stderr.write("known-failing: can't read %s: %s\n" % (path, e)); sys.exit(2)
    for tc in tree.iter("testcase"):
        if tc.find("skipped") is not None:
            continue
        cls = tc.get("classname") or tc.get("file") or ""
        tid = (cls + "::" if cls else "") + (tc.get("name") or "")
        failed = tc.find("failure") is not None or tc.find("error") is not None
        print(("fail" if failed else "pass") + "\t" + tid.replace("\n", " "))
PY
}

# match <id>: true if a list entry is the ID, or a pattern that matches it
match() {
  local e
  while IFS= read -r e; do
    [ "$e" = "$1" ] && return 0
    # shellcheck disable=SC2053  # the entry is meant to be a pattern
    [[ "$1" == $e ]] && return 0
  done < <(entries)
  return 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  count) entries | grep -c '' ;;
  list) entries ;;
  check|init)
    [ $# -gt 0 ] || die "usage: known-failing $cmd <junit.xml>..."
    out="$(results "$@")" || exit 2
    [ -n "$out" ] || die "no test cases in $* (did the runner write its report?)"
    fails="$(printf '%s\n' "$out" | awk -F'\t' '$1 == "fail" { print $2 }' | sort -u)"
    if [ "$cmd" = init ]; then
      target="$list"
      if [ -f "$list" ]; then target="$(sy_dir "$root")/pending/$(sy_rel "$root" "$list")"; fi
      mkdir -p "$(dirname "$target")"
      { echo "# Known failing tests. Only new failures fail the suite. Fix these and remove them."
        echo "# Recorded $(date '+%Y-%m-%d') at $(git rev-parse --short HEAD 2>/dev/null || echo 'no commit')."
        [ -n "$fails" ] && printf '%s\n' "$fails"; } >"$target"
      n="$(printf '%s' "$fails" | grep -c '')"
      if [ "$target" = "$list" ]; then echo "known-failing: listed $n failing tests in ${list#"$root"/}. Commit it."
      else echo "known-failing: the list is protected, so the new one ($n tests) is a proposal in ${target#"$root"/}. A human applies it with: shipinetics-config apply"; fi
      exit 0
    fi
    new=() known=0 fixed=()
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if match "$t"; then known=$((known + 1)); else new+=("$t"); fi
    done <<<"$fails"
    while IFS= read -r t; do
      [ -n "$t" ] && match "$t" && fixed+=("$t")
    done < <(printf '%s\n' "$out" | awk -F'\t' '$1 == "pass" { print $2 }' | sort -u)
    total="$(printf '%s\n' "$out" | grep -c '')"
    echo "known-failing: $total tests, $known known failures (quarantined), ${#new[@]} new failures."
    if [ "${#fixed[@]}" -gt 0 ]; then
      echo "Listed but passing now (propose removing them from the list):"; printf '  %s\n' "${fixed[@]}"
    fi
    if [ "${#new[@]}" -gt 0 ]; then
      echo "New failures:" >&2; printf '  %s\n' "${new[@]}" >&2
      exit 1
    fi
    ;;
  -h|--help|"") sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd" ;;
esac
