#!/usr/bin/env bash
# known-failing: gate a test suite that already has failures, so only new failures fail.
#
# Usage:
#   known-failing check [--rerun '<cmd>'] <junit.xml>...
#                                        exit 1 if a test failed that isn't on the list. Also names
#                                        listed tests that pass now, so the list can shrink.
#                                        With --rerun, new failures run once more: the ones that pass
#                                        then are named flaky. They still fail the check
#   known-failing hunt [-n N] -- <cmd>   run the suite N times (default 5) and name the tests that
#                                        both passed and failed: flaky. Exit 1 if there are any
#   known-failing flaky                  the flaky tests that check --rerun found, most often first
#   known-failing init <junit.xml>...    write today's failures as the list (a proposal in
#                                        .shipinetics/pending/ if the list already exists)
#   known-failing count                  how many entries the list has
#   known-failing list                   print them
#
# The list is .shipinetics/known-failing: one test ID per line. An ID is
# "<classname>::<name>" from the JUnit report (the file instead of the classname if there's none).
# A comment line starts with "#". An entry with * or ? is a pattern (other characters, [ and ]
# included, match themselves). Any other entry must equal the ID. The list is protected (it's
# under .shipinetics/), so only a human adds to it; agents propose changes through
# .shipinetics/pending/.
# Most runners write JUnit XML: vitest --reporter=junit, jest-junit, pytest --junitxml,
# go-junit-report, cargo nextest, Playwright's junit reporter.
# Without a list, every failure counts. A report with no test cases fails, so a broken runner
# can't pass as "nothing new failed".
# In <cmd>, {junit} is the path the command must write its JUnit report to, and {ids} a file with
# the IDs to run, one per line (a command may ignore it and run the whole suite).
# A re-run never turns a failure into a pass: it only tells a race from a real break.
# Flaky tests that check finds go to .shipinetics/.cache/flaky.tsv (date, commit, ID).

set -uo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
# Runs from the plugin, or as a copy in a project's bin/ (CI has no plugin), with just what it needs.
if [ -f "$here/.claude-plugin/plugin.json" ] && [ -f "$here/scripts/lib.sh" ]; then
  # shellcheck source=../scripts/lib.sh
  . "$here/scripts/lib.sh"
else
  sy_root() { local d="$PWD"; while [ ! -d "$d/.shipinetics" ]; do [ "$d" = / ] && return 1; d="$(dirname "$d")"; done; echo "$d"; }
  sy_dir() { echo "$1/.shipinetics"; }
  sy_rel() { case "$2" in "$1"/*) echo "${2#"$1"/}" ;; *) echo "$2" ;; esac; }
  sy_env() { local n="SHIPINETICS_$1"; if [ -n "${!n+x}" ]; then echo "${!n}"; else echo "${2:-}"; fi; }
fi
die() { echo "known-failing: $*" >&2; exit 2; }

root="$(sy_root 2>/dev/null)" || root="$(sy_git_top)" || root="$PWD"
list="$(sy_dir "$root")/known-failing"
command -v python3 >/dev/null 2>&1 || die "python3 is required"

flaky_log="$(sy_dir "$root")/.cache/flaky.tsv"

# fill <cmd> <junit> <ids>: the command with its placeholders replaced by quoted paths
fill() { local c="$1" j i; j="$(printf '%q' "$2")"; i="$(printf '%q' "$3")"; c="${c//\{junit\}/$j}"; printf '%s' "${c//\{ids\}/$i}"; }

entries() { [ -f "$list" ] && sed -e '/^[[:space:]]*#/d' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$list" | grep -v '^$'; }

# results <junit.xml>...: "<pass|fail>\t<id>" per test case
results() {
  python3 - "$@" <<'PY'
import sys, xml.etree.ElementTree as ET
for path in sys.argv[1:]:
    try:
        tree = ET.parse(path)
    except (OSError, ET.ParseError) as e:
        sys.stderr.write("known-failing: can't read %s: %s\n" % (path, e)); sys.exit(2)
    for tc in tree.iter("testcase"):
        if tc.find("skipped") is not None:
            continue
        cls = tc.get("classname") or tc.get("file") or ""
        tid = (cls + "::" if cls else "") + (tc.get("name") or "")
        failed = tc.find("failure") is not None or tc.find("error") is not None
        print(("fail" if failed else "pass") + "\t" + tid.replace("\n", " "))
PY
}

# match <id>: true if a list entry is the ID, or a pattern (with * or ?) that matches it
match() {
  local e p
  while IFS= read -r e; do
    [ "$e" = "$1" ] && return 0
    case "$e" in *[*?]*) ;; *) continue ;; esac
    p="${e//\[/\\[}"; p="${p//\]/\\]}"
    # shellcheck disable=SC2053  # the entry is meant to be a pattern
    [[ "$1" == $p ]] && return 0
  done < <(entries)
  return 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  count) entries | grep -c '' || true ;;
  list) entries ;;
  flaky)
    [ -f "$flaky_log" ] || { echo "known-failing: no flaky test recorded yet"; exit 0; }
    cut -f3 "$flaky_log" | sort | uniq -c | sort -rn | awk '{ n = $1; $1 = ""; printf "%4d  %s\n", n, substr($0, 2) }'
    ;;
  hunt)
    n=5
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      case "$1" in -n) n="$2"; shift 2 ;; *) die "usage: known-failing hunt [-n N] -- <cmd with {junit}>" ;; esac
    done
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || die "usage: known-failing hunt [-n N] -- <cmd with {junit}>"
    case "$*" in *"{junit}"*) ;; *) die "the command must write its report to {junit}" ;; esac
    d="$(mktemp -d "${TMPDIR:-/tmp}/kf-hunt.XXXXXX")"; trap 'rm -rf "$d"' EXIT
    : >"$d/ids"; : >"$d/all"
    for i in $(seq 1 "$n"); do
      sh -c "$(fill "$*" "$d/run$i.xml" "$d/ids")" >"$d/run$i.log" 2>&1 </dev/null || true
      r="$(results "$d/run$i.xml" 2>/dev/null)" || r=""
      [ -n "$r" ] || die "run $i wrote no test cases to {junit}. Its output: $d/run$i.log"
      printf '%s\n' "$r" | sort -u >>"$d/all"
    done
    out="$(awk -F'\t' '{ k[$2]; if ($1 == "fail") f[$2]++; else p[$2]++ }
      END { for (t in k) if (f[t] && p[t]) printf "%d\t%s\n", f[t], t }' "$d/all" | sort -rn)"
    always="$(awk -F'\t' '{ k[$2]; if ($1 == "fail") f[$2]++; else p[$2]++ }
      END { for (t in k) if (f[t] && !p[t]) print t }' "$d/all" | sort)"
    total="$(cut -f2 "$d/all" | sort -u | grep -c '')"
    echo "known-failing: $n runs of $total tests."
    if [ -n "$always" ]; then echo "Failed on every run (broken, not flaky):"; printf '%s\n' "$always" | sed 's/^/  /'; fi
    if [ -n "$out" ]; then
      echo "Flaky (passed and failed in the same code):"
      printf '%s\n' "$out" | while IFS=$'\t' read -r k t; do echo "  $t (failed $k of $n)"; done
      exit 1
    fi
    echo "No flaky test found."
    ;;
  check|init)
    rerun=""
    if [ "$cmd" = check ] && [ "${1:-}" = "--rerun" ]; then rerun="${2:-}"; shift 2 || true; fi
    [ $# -gt 0 ] || die "usage: known-failing $cmd <junit.xml>..."
    out="$(results "$@")" || exit 2
    [ -n "$out" ] || die "no test cases in $* (did the runner write its report?)"
    fails="$(printf '%s\n' "$out" | awk -F'\t' '$1 == "fail" { print $2 }' | sort -u)"
    if [ "$cmd" = init ]; then
      target="$list"
      if [ -f "$list" ]; then target="$(sy_dir "$root")/pending/$(sy_rel "$root" "$list")"; fi
      mkdir -p "$(dirname "$target")"
      { echo "# Known failing tests. Only new failures fail the suite. Fix these and remove them."
        echo "# Recorded $(date '+%Y-%m-%d') at $(git rev-parse --short HEAD 2>/dev/null || echo 'no commit')."
        [ -n "$fails" ] && printf '%s\n' "$fails"; } >"$target"
      n="$(printf '%s' "$fails" | grep -c '')"
      if [ "$target" = "$list" ]; then echo "known-failing: listed $n failing tests in ${list#"$root"/}. Commit it."
      else echo "known-failing: the list is protected, so the new one ($n tests) is a proposal in ${target#"$root"/}. A human applies it. Run shipinetics-config pending and give the user its output: it says why, and it gives the exact command."; fi
      exit 0
    fi
    new=() known=0 fixed=()
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      if match "$t"; then known=$((known + 1)); else new+=("$t"); fi
    done <<<"$fails"
    while IFS= read -r t; do
      [ -n "$t" ] && match "$t" && fixed+=("$t")
    done < <(printf '%s\n' "$out" | awk -F'\t' '$1 == "pass" { print $2 }' | sort -u)
    total="$(printf '%s\n' "$out" | grep -c '')"
    echo "known-failing: $total tests, $known known failures (quarantined), ${#new[@]} new failures."
    if [ "${#fixed[@]}" -gt 0 ]; then
      echo "Listed but passing now (propose removing them from the list):"; printf '  %s\n' "${fixed[@]}"
    fi
    if [ "${#new[@]}" -gt 0 ] && [ -n "$rerun" ]; then
      d="$(mktemp -d "${TMPDIR:-/tmp}/kf-rerun.XXXXXX")"; trap 'rm -rf "$d"' EXIT
      printf '%s\n' "${new[@]}" >"$d/ids"
      sh -c "$(fill "$rerun" "$d/rerun.xml" "$d/ids")" >"$d/rerun.log" 2>&1 </dev/null || true
      again="$(results "$d/rerun.xml" 2>/dev/null)" || again=""
      if [ -z "$again" ]; then
        echo "known-failing: the re-run wrote no report, so every new failure counts as failing. Its output: $(tail -n 5 "$d/rerun.log")" >&2
      else
        flaky=() broken=()
        for t in "${new[@]}"; do
          if printf '%s\n' "$again" | grep -qxF -- "pass	$t"; then flaky+=("$t"); else broken+=("$t"); fi
        done
        if [ "${#flaky[@]}" -gt 0 ]; then
          mkdir -p "$(dirname "$flaky_log")"
          c="$(git rev-parse --short HEAD 2>/dev/null || echo none)"
          for t in "${flaky[@]}"; do printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d')" "$c" "$t" >>"$flaky_log"; done
          echo "Flaky (failed, then passed on a re-run). Still a failure: find the race or the shared state:" >&2
          printf '  %s\n' "${flaky[@]}" >&2
        fi
        if [ "${#broken[@]}" -gt 0 ]; then echo "New failures (failed again on a re-run):" >&2; printf '  %s\n' "${broken[@]}" >&2; fi
        exit 1
      fi
    fi
    if [ "${#new[@]}" -gt 0 ]; then
      echo "New failures:" >&2; printf '  %s\n' "${new[@]}" >&2
      exit 1
    fi
    ;;
  -h|--help|"") sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd" ;;
esac
