#!/usr/bin/env bash
# shipinetics-usage: the tokens that each Claude Code and Antigravity session used, read from
# their transcripts on this machine. No model runs, so it costs no tokens.
#
# Usage:
#   shipinetics-usage                  this project's sessions: tokens by type, and the totals
#   shipinetics-usage session [id]     one session (default: this project's newest), by agent and
#                                      model, with the rows for the worksheet Metrics
#   shipinetics-usage html [--out f]   an HTML page with charts and filters by harness, model and
#                                      date (--open opens it in your browser)
#   shipinetics-usage serve            live auto-refreshing local dashboard on 127.0.0.1 (--port N,
#                                      --interval S, --no-open)
#   shipinetics-usage backfill         record the transcripts that the log doesn't have yet
# Options: --all (every project), --days N (default 30; 0 means all time),
#          --harness all|antigravity|claude, --model <name>
#
# The SessionEnd hook (Claude Code) and Stop hook (Antigravity) record each session automatically.
# The log keeps the numbers even after old transcripts are pruned:
# ${XDG_DATA_HOME:-~/.local/share}/shipinetics/usage.tsv (SHIPINETICS_USAGE_LOG overrides it).
# Exit codes: 0 success, 1 no session found, 2 bad usage or no python3.

set -uo pipefail
# shellcheck source=../scripts/compat.sh
compat="$(cd "$(dirname "$0")/.." && pwd)/scripts/compat.sh"; [ -f "$compat" ] && . "$compat"
case "${1:-}" in -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
here="$(cd "$(dirname "$0")/.." && pwd)"
command -v python3 >/dev/null 2>&1 || { echo "shipinetics-usage: python3 is required" >&2; exit 2; }
# exec, so a server (serve) is this process and stops with it. On Windows, python3 is a function
# from compat.sh, which exec can't run: run the interpreter that compat.sh found, in UTF-8 mode.
# usage.py prints LF line endings on Windows itself, so no "\r" filter (which would hold a
# server's output in a buffer) is needed.
if declare -F python3 >/dev/null 2>&1 && [ -n "${SY_PYTHON:-}" ]; then
  # shellcheck disable=SC2086  # SY_PYTHON can be "py -3"
  exec $SY_PYTHON -X utf8 -I "$here/scripts/usage.py" "$@"
fi
exec python3 -I "$here/scripts/usage.py" "$@"
