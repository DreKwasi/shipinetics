#!/usr/bin/env bash
# shipinetics-antigravity: the old name for `shipinetics <command> antigravity`. It still works, and
# a later breaking release removes it.
#
# Usage:
#   shipinetics-antigravity install [--target <dir>]   same as: shipinetics install antigravity
#   shipinetics-antigravity link-skills                same as: shipinetics link-skills antigravity
#   shipinetics-antigravity status [--target <dir>]    same as: shipinetics status antigravity
#   shipinetics-antigravity refresh [--target <dir>]   same as: shipinetics refresh antigravity
#   shipinetics-antigravity uninstall [--target <dir>] same as: shipinetics uninstall antigravity
#
# install writes generated copies of the skills and subagents into
# ~/.gemini/config/plugins/shipinetics (default), and links hooks.json, scripts and bin to this clone.
# Run `shipinetics refresh antigravity` after the clone changes. Exit codes: as for shipinetics.

set -uo pipefail
usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in -h|--help|"") usage; exit 0 ;; esac
cmd="$1"; shift
case "$cmd" in
  install|link-skills|status|refresh|uninstall) ;;
  *) echo "shipinetics-antigravity: unknown command: $cmd (use install, link-skills, status, refresh or uninstall)" >&2; exit 2 ;;
esac
echo "(shipinetics-antigravity is now: shipinetics $cmd antigravity)" >&2
exec "$(cd "$(dirname "$0")" && pwd -P)/shipinetics" "$cmd" antigravity "$@"
