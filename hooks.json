{
  "shipinetics": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/companions-notice.sh",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-edits.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-secrets.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-pr.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "./scripts/guard-installs.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/usage-record.sh",
        "timeout": 5
      }
    ]
  }
}
